<Window x:Class="RedScreen.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RedScreen"
        Title="RedScreen" Icon="app.ico" Width="460" Height="760" MinHeight="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        Foreground="{StaticResource TextBrush}" UseLayoutRounding="True">

    <Window.Resources>
        <!-- Fargeprikk + navn, brukt i nedtrekkslisten for moduser -->
        <DataTemplate x:Key="ModeChoice">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="14" Height="14" Fill="{Binding PreviewBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!-- Ytre ramme med skygge og runde hjørner -->
    <Border Margin="14" CornerRadius="26" Background="{StaticResource WindowBrush}"
            BorderBrush="#26262C" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.55"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== Tittellinje ===== -->
            <Grid Grid.Row="0" Margin="22,16,14,6" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="TitleDot" Width="14" Height="14" Margin="0,0,10,0"
                             Fill="{StaticResource AccentBrush}"/>
                    <TextBlock Text="RedScreen" Style="{StaticResource Title}" FontSize="19"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Språkvelger: rund pille med globus og språkkode -->
                    <Button x:Name="LanguageButton" Style="{StaticResource PillButton}"
                            ToolTip="{DynamicResource win.language}" Click="LanguageButton_Click" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="LanguageLabel" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="LanguageMenu" Placement="Bottom"/>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="{DynamicResource win.minimize}"
                            Click="Minimize_Click" FontSize="10"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="{DynamicResource win.close}"
                            Click="Close_Click" FontSize="10" Margin="2,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ===== Faner ===== -->
            <Border Grid.Row="1" Margin="22,8,22,12" Background="{StaticResource CardBrush}"
                    CornerRadius="16" Padding="4">
                <UniformGrid Columns="2">
                    <RadioButton x:Name="ModesTab" Content="{DynamicResource tab.modes}" GroupName="Tabs" IsChecked="True"
                                 Style="{StaticResource SegmentTab}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="AutomationsTab" Content="{DynamicResource tab.automations}" GroupName="Tabs"
                                 Style="{StaticResource SegmentTab}" Checked="Tab_Checked"/>
                </UniformGrid>
            </Border>

            <!-- ===================== MODUSER ===================== -->
            <ScrollViewer x:Name="ModesPage" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          Padding="22,0,22,18">
                <StackPanel>

                    <!-- Nå-kort -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="48" Height="48" Margin="0,0,14,0">
                                    <Ellipse x:Name="NowGlow" Opacity="0.35">
                                        <Ellipse.Effect><BlurEffect Radius="14"/></Ellipse.Effect>
                                    </Ellipse>
                                    <Ellipse x:Name="NowDot" Width="40" Height="40"/>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="NowTitle" Style="{StaticResource Heading}" FontSize="17" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="NowSub" Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                                    <!-- Hvem som satte filteret: automasjon eller manuelt -->
                                    <StackPanel x:Name="NowSourcePanel" Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock x:Name="NowSourceIcon" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="NowSource" Style="{StaticResource Caption}" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                <CheckBox x:Name="FilterSwitch" Grid.Column="2" Style="{StaticResource Switch}"
                                          VerticalAlignment="Center" ToolTip="{DynamicResource now.toggleTip}"
                                          Checked="FilterSwitch_Changed" Unchecked="FilterSwitch_Changed"/>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="{DynamicResource slider.temperature}" Style="{StaticResource Sub}"/>
                                <TextBlock x:Name="KelvinValue" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13"/>
                            </Grid>
                            <Slider x:Name="KelvinSlider" Style="{StaticResource RoundSlider}"
                                    Background="{StaticResource KelvinTrackBrush}"
                                    Minimum="500" Maximum="10000" TickFrequency="50"
                                    SmallChange="50" LargeChange="500" ValueChanged="Slider_ValueChanged"/>
                            <Grid Margin="2,2,2,14">
                                <TextBlock Text="{DynamicResource slider.fullRed}" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{DynamicResource slider.cool}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="{DynamicResource slider.brightness}" Style="{StaticResource Sub}"/>
                                <TextBlock x:Name="BrightnessValue" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13"/>
                            </Grid>
                            <Slider x:Name="BrightnessSlider" Style="{StaticResource RoundSlider}"
                                    Background="{StaticResource BrightnessTrackBrush}"
                                    Minimum="20" Maximum="100" TickFrequency="5"
                                    SmallChange="5" LargeChange="10" ValueChanged="Slider_ValueChanged"/>

                            <!-- Vises når automasjonene er satt på pause av en manuell endring -->
                            <Border x:Name="OverrideBanner" Visibility="Collapsed" Margin="0,16,0,0"
                                    Background="#26201F" CornerRadius="14" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{DynamicResource override.title}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="OverrideSub" Style="{StaticResource Caption}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{DynamicResource override.resume}" Style="{StaticResource AccentButton}"
                                            Padding="14,7" VerticalAlignment="Center" Click="Resume_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Mine moduser -->
                    <Border Style="{StaticResource Card}" Padding="14,16">
                        <StackPanel>
                            <Grid Margin="6,0,2,10">
                                <StackPanel VerticalAlignment="Center" Margin="0,0,46,0">
                                    <TextBlock Text="{DynamicResource modes.title}" Style="{StaticResource Heading}"/>
                                    <TextBlock Text="{DynamicResource modes.hint}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Style="{StaticResource PlusButton}" Content="&#xE710;" ToolTip="{DynamicResource modes.addTip}"
                                        HorizontalAlignment="Right" Click="AddMode_Click"/>
                            </Grid>

                            <!-- Navnefelt for ny modus / nytt navn -->
                            <Border x:Name="NamePanel" Visibility="Collapsed" Background="{StaticResource CardHoverBrush}"
                                    CornerRadius="16" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock x:Name="NamePanelTitle" Style="{StaticResource Sub}" Margin="2,0,0,8"/>
                                    <TextBox x:Name="NameBox" Style="{StaticResource RoundTextBox}" KeyDown="NameBox_KeyDown" MaxLength="40"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                        <Button Content="{DynamicResource common.cancel}" Style="{StaticResource SoftButton}" Padding="14,7"
                                                Click="NameCancel_Click" Margin="0,0,8,0"/>
                                        <Button Content="{DynamicResource common.save}" Style="{StaticResource AccentButton}" Padding="16,7"
                                                Click="NameSave_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Vises når det ikke finnes moduser ennå -->
                            <TextBlock x:Name="ModesEmpty" Text="{DynamicResource modes.empty}" Style="{StaticResource Sub}"
                                       Margin="6,4,6,6" Visibility="Collapsed"/>

                            <ItemsControl x:Name="ModesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:Mode}">
                                        <Button Style="{StaticResource ModeRow}" Click="ModeRow_Click" Margin="0,2">
                                            <Grid x:Name="Row">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="30" Height="30" Fill="{Binding PreviewBrush}" Margin="0,0,12,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <StackPanel x:Name="Actions" Grid.Column="2" Orientation="Horizontal" Opacity="0">
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE74E;"
                                                            ToolTip="{DynamicResource modes.updateTip}" Click="ModeUpdate_Click"/>
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE70F;"
                                                            ToolTip="{DynamicResource modes.renameTip}" Click="ModeRename_Click"/>
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;"
                                                            ToolTip="{DynamicResource common.delete}" Click="ModeDelete_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Actions" Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===================== AUTOMASJONER ===================== -->
            <ScrollViewer x:Name="AutomationsPage" Grid.Row="2" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" Padding="22,0,22,18">
                <StackPanel>

                    <!-- Dagtid: tidsrom der filteret er av -->
                    <Border x:Name="DayOffCard" Padding="16" DataContext="{Binding DayOff}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE706;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                   Foreground="#FFC857" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource dayoff.title}" Style="{StaticResource Heading}"/>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource dayoff.sub}" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </CheckBox>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBox Style="{StaticResource RoundTextBox}" Width="88" FontSize="16" FontWeight="SemiBold"
                                         Padding="4,5" HorizontalContentAlignment="Center"
                                         Text="{Binding StartText, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="{DynamicResource auto.timeTip}" KeyDown="TimeBox_KeyDown"/>
                                <TextBlock Text="{DynamicResource dayoff.to}" Style="{StaticResource Sub}"
                                           VerticalAlignment="Center" Margin="12,0"/>
                                <TextBox Style="{StaticResource RoundTextBox}" Width="88" FontSize="16" FontWeight="SemiBold"
                                         Padding="4,5" HorizontalContentAlignment="Center"
                                         Text="{Binding EndText, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="{DynamicResource auto.timeTip}" KeyDown="TimeBox_KeyDown"/>
                            </StackPanel>
                        </StackPanel>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                        <Setter Property="Opacity" Value="0.6"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- Vises når listen er tom -->
                    <Border x:Name="AutomationsEmpty" Style="{StaticResource Card}" Visibility="Collapsed">
                        <TextBlock x:Name="AutomationsEmptyText" Text="{DynamicResource auto.empty}" Style="{StaticResource Sub}" TextAlignment="Center"/>
                    </Border>

                    <ItemsControl x:Name="AutomationsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:Automation}">
                                <Border x:Name="Card" Style="{StaticResource Card}" Padding="16">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource RoundTextBox}" FontSize="17" FontWeight="SemiBold"
                                                     Padding="4,6" HorizontalContentAlignment="Center"
                                                     Text="{Binding TimeText, UpdateSourceTrigger=LostFocus}"
                                                     ToolTip="{DynamicResource auto.timeTip}"
                                                     LostKeyboardFocus="TimeBox_LostFocus" KeyDown="TimeBox_KeyDown"/>
                                            <ComboBox Grid.Column="1" Margin="10,0,10,0" Style="{StaticResource RoundCombo}"
                                                      ToolTip="{DynamicResource auto.modeTip}"
                                                      ItemsSource="{Binding DataContext.Modes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedValuePath="Id" SelectedValue="{Binding ModeId, Mode=TwoWay}"
                                                      ItemTemplate="{StaticResource ModeChoice}"/>
                                            <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}"
                                                      VerticalAlignment="Center" ToolTip="{DynamicResource auto.enabledTip}"/>
                                            <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE74D;"
                                                    ToolTip="{DynamicResource common.delete}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                    Click="AutomationDelete_Click"/>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0" ToolTip="{DynamicResource auto.daysTip}">
                                            <ToggleButton Style="{StaticResource DayPill}" Content="{DynamicResource day.mon.short}" ToolTip="{DynamicResource day.mon}" IsChecked="{Binding Monday}"/>
                                            <ToggleButton Style="{StaticResource DayPill}" Content="{DynamicResource day.tue.short}" ToolTip="{DynamicResource day.tue}" IsChecked="{Binding Tuesday}"/>
                                            <ToggleButton Style="{StaticResource DayPill}" Content="{DynamicResource day.wed.short}" ToolTip="{DynamicResource day.wed}" IsChecked="{Binding Wednesday}"/>
                                            <ToggleButton Style="{StaticResource DayPill}" Content="{DynamicResource day.thu.short}" ToolTip="{DynamicResource day.thu}" IsChecked="{Binding Thursday}"/>
                                            <ToggleButton Style="{StaticResource DayPill}" Content="{DynamicResource day.fri.short}" ToolTip="{DynamicResource day.fri}" IsChecked="{Binding Friday}"/>
                                            <ToggleButton Style="{StaticResource DayPill}" Content="{DynamicResource day.sat.short}" ToolTip="{DynamicResource day.sat}" IsChecked="{Binding Saturday}"/>
                                            <ToggleButton Style="{StaticResource DayPill}" Content="{DynamicResource day.sun.short}" ToolTip="{DynamicResource day.sun}" IsChecked="{Binding Sunday}"/>
                                        </StackPanel>

                                        <Grid Margin="0,14,0,4" ToolTip="{DynamicResource auto.fadeTip}" Background="Transparent">
                                            <TextBlock Text="{DynamicResource auto.fade}" Style="{StaticResource Sub}"/>
                                            <TextBlock Text="{Binding FadeText}"
                                                       HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13"/>
                                        </Grid>
                                        <Slider Style="{StaticResource RoundSlider}" Minimum="0" Maximum="60" TickFrequency="5"
                                                SmallChange="5" LargeChange="15" Value="{Binding FadeMinutes, Mode=TwoWay}"/>

                                        <!-- Advarsel når klokkeslettet ligger i dagtid-vinduet -->
                                        <Border x:Name="SkipNote" Visibility="Collapsed" Margin="0,12,0,0"
                                                Background="#2A2618" CornerRadius="10" Padding="10,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE706;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                           Foreground="#FFC857" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{DynamicResource dayoff.skipped}" FontSize="12" Foreground="#FFC857"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                        <Setter TargetName="Card" Property="Opacity" Value="0.5"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding InDayOff}" Value="True">
                                        <Setter TargetName="SkipNote" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button x:Name="AddAutomationButton" Style="{StaticResource SoftButton}" Padding="0,12" Click="AddAutomation_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource auto.add}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Start med Windows: samme verdi som i tray-menyen (registeret) -->
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                        <CheckBox x:Name="AutostartSwitch" Style="{StaticResource Switch}" Click="AutostartSwitch_Click">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{DynamicResource autostart.title}" Style="{StaticResource Heading}"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource autostart.sub}" Style="{StaticResource Caption}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
