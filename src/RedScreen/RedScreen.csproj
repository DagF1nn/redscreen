<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms brukes kun for NotifyIcon (tray-ikonet) -->
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- Ikonet lages av IconFactory.SaveAppIco (kjør appen med tray-snapshot-flagget for å lage det på nytt). -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Produktnavn og versjon i filene (kreves for signering via SignPath). -->
    <Product>RedScreen</Product>
    <Version>0.1.0</Version>
    <Description>Makes the screen warm, red and dim in the evening.</Description>
    <Copyright>Copyright (c) 2026 DagF1nn</Copyright>
  </PropertyGroup>

  <!-- Smart App Control blokkerer usignert RedScreen.exe. Under utvikling
       kjører vi derfor via dotnet.exe (signert av Microsoft) i stedet. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unngå navnekollisjoner mellom WPF og WinForms -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
